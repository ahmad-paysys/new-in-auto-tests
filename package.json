{
  "name": "rule-studio-test-automation",
  "version": "1.0.0",
  "description": "Playwright test automation framework for Rule Studio /masking/* endpoints",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:critical": "playwright test --grep \"@smoke|@critical\"",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e-fo": "playwright test --project=e2e-frontend-only",
    "test:e2e-fo:smoke": "playwright test --project=e2e-frontend-only --grep @smoke",
    "test:e2e-fo:critical": "playwright test --project=e2e-frontend-only --grep \"@smoke|@critical\"",
    "test:e2e-fo:regression": "playwright test --project=e2e-frontend-only --grep @regression",
    "test:e2e-fo:negative": "playwright test --project=e2e-frontend-only --grep @negative",
    "test:rbac": "playwright test --grep @rbac",
    "test:workflow": "playwright test --grep @workflow",
    "test:report": "playwright show-report",
    "test:clean": "rimraf test-results playwright-report .auth"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^25.6.0",
    "dotenv": "^16.4.7",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3"
  }
}
