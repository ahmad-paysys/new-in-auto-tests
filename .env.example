# API base URL (extracted from Swagger, override per environment)
BASE_URL=http://10.10.80.37:3005

# Frontend URL for E2E tests
FRONTEND_URL=http://10.10.80.37:5174

# Frontend encryption key — must match the deployed frontend's VITE_CRYPTO_KEY.
# Used to AES-encrypt tokens before injecting into sessionStorage (the frontend
# decrypts sessionStorage values with this key).
VITE_CRYPTO_KEY=

# Environment: local | staging | production
TEST_ENV=staging
